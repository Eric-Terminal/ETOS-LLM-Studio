// 提示词宏：语法、可用变量与缓存说明。
"查看可用宏" = "Macros disponibles";
"提示词宏语法说明" = "Les noms de macros ne sont pas sensibles à la casse et acceptent des espaces à l’intérieur des accolades. Les accolades simples, {name}, sont aussi développées. Les macros inconnues restent inchangées. Les valeurs proviennent de l’appareil qui envoie la requête ; une valeur indisponible renvoie unknown.";
"日期与时间" = "Date et heure";
"提示词宏时间列表" = "{{cur_date}} — date locale (yyyy-MM-dd)\n{{cur_time}} — heure locale (HH:mm:ss)\n{{cur_datetime}} — date et heure locales\n{{utc_datetime}} — heure UTC au format ISO 8601\n{{weekday}} — jour de la semaine\n{{timestamp}} — horodatage Unix en secondes\n{{timezone}} — identifiant du fuseau horaire\n{{timezone_offset}} — décalage UTC, par exemple +08:00";
"模型与供应商" = "Modèle et fournisseur";
"提示词宏模型列表" = "{{model_id}} — ID du modèle dans l’API\n{{model_name}} — nom affiché du modèle\n{{provider_id}} — ID du fournisseur\n{{provider_name}} — nom du fournisseur\n{{api_format}} — format d’API utilisé pour cette requête";
"称呼与会话" = "Noms et conversation";
"提示词宏会话列表" = "{{nickname}} / {{user}} — nom de la Persona actuelle ou par défaut ; sinon, désignation de l’utilisateur\n{{char}} / {{assistant_name}} — nom du personnage ; sinon, nom du modèle\n{{chat_id}} — ID de la conversation\n{{chat_name}} — nom de la conversation\n{{message_count}} — nombre de messages utilisateur et assistant préparés pour cette requête";
"语言与应用" = "Langue et application";
"提示词宏应用列表" = "{{locale}} — identifiant régional de l’app\n{{language}} — nom de la langue de l’app\n{{system_locale}} — identifiant régional du système\n{{app_name}} — nom de l’app\n{{app_version}} — version de l’app\n{{app_build}} — numéro de build";
"设备信息" = "Informations sur l’appareil";
"提示词宏设备列表" = "{{platform}} — plateforme, comme iOS ou watchOS\n{{system_version}} — plateforme et version du système\n{{device_info}} — type d’appareil et ID du modèle\n{{device_model}} — identifiant du modèle matériel\n{{device_name}} — nom de l’appareil fourni par le système";
"电量与运行状态" = "Batterie et état du système";
"提示词宏状态列表" = "{{battery_level}} — pourcentage de batterie, 0–100 sans %\n{{battery_state}} — unplugged (débranché), charging (en charge), full (chargé) ou unknown\n{{is_charging}} — true, false ou unknown ; false lorsque la charge est complète\n{{low_power_mode}} — mode économie d’énergie, true ou false\n{{thermal_state}} — nominal (normal), fair (tiède), serious (chaud), critical (surchauffe) ou unknown\n{{system_uptime}} — durée depuis le démarrage en secondes\nLa batterie est lue uniquement si ses macros sont utilisées, sans interrogation en arrière-plan.";
"提示词宏" = "Macros de prompt";
"提示词宏缓存说明" = "Les valeurs qui changent peuvent réduire la réutilisation du cache à partir de leur position. Les instructions complémentaires sont placées à la fin. Vous choisissez où utiliser les macros ; le cache dépend du fournisseur et du format API.";
"提示词宏使用说明" = "Les instructions système, celles de la conversation, les instructions du sujet, les instructions complémentaires et la saisie du chat acceptent les macros. Les instructions et messages utilisateur enregistrés conservent leur texte original. Les macros sont réévaluées à chaque requête, y compris dans les anciens messages utilisateur envoyés avec celle-ci.";
"提示词宏双三括号说明" = "Les doubles accolades insèrent la valeur actuelle. Les triples accolades envoient le texte de la macro sans la développer. Par exemple, avec une batterie à 90 % :";
"提示词宏展开示例" = "{{battery_level}} → 90\n{{{battery_level}}} → {{battery_level}}";
"提示词宏时间注入说明" = "L’heure système peut être ajoutée au début ou à la fin, ou insérée ailleurs avec les macros. Ses changements peuvent réduire la réutilisation du cache à partir de cette position.";
